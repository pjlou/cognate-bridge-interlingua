# Postgres connection string. Neon, Render and Fly all hand you one of these.
# Local development via `docker compose up -d` (see docker-compose.yml) publishes
# on 5433, not Postgres's usual 5432, so this can run alongside another local
# Postgres/Cognate Bridge checkout without a port conflict.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cognate_bridge

# Separate database used by `npm test`. Integration tests are skipped when unset,
# so the unit test suite still runs on a machine with no Postgres.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/cognate_bridge_test

# Required in production; the server refuses to boot without it.
JWT_SECRET=change-me-in-production

# 3002, not the usual 3001, so this can run alongside another local
# Cognate Bridge checkout without a port conflict.
PORT=3002
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5174

# Optional. When set, study Reveal can use Google Cloud TTS with IPA phonemes.
# Leave unset to keep browser Web Speech / Piper (default).
# GOOGLE_TTS_API_KEY=

# Optional local TTS via Piper (https://github.com/rhasspy/piper).
# Point these at a Piper binary and a folder of .onnx voice models.
# See README "Local TTS with Piper".
# PIPER_BIN=C:\tools\piper\piper.exe
# PIPER_VOICES_DIR=C:\tools\piper\voices

# Experimental bridges (comma-separated). Empty = hidden from the API/UI.
# Finnish (`fin`) is a pedagogical creator testbed with Estonian cognates only.
# ENABLE_EXPERIMENTAL_BRIDGES=fin
